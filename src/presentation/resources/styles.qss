/* SMSCaster - Modern Desktop Interface */

QMainWindow,
QWidget#appRoot {
    background-color: #f4f7fb;
}

QWidget {
    color: #1f2937;
    font-family: "Segoe UI", "Tahoma", "Arial";
    font-size: 12px;
}

/* ---------- Top bar ---------- */
QFrame#topBar {
    background: #ffffff;
    border-bottom: 1px solid #dbe4ef;
}

QLabel#brandTitle {
    color: #0f4c81;
    font-size: 22px;
    font-weight: 800;
}

QLabel#brandSubtitle {
    color: #64748b;
    font-size: 13px;
    padding-right: 8px;
}

QPushButton#topPrimaryButton {
    background: #1677d2;
    border-color: #1677d2;
    min-width: 125px;
}

QPushButton#topPrimaryButton:hover {
    background: #1268ba;
    border-color: #1268ba;
}

QPushButton#topSecondaryButton,
QPushButton#topConnectionButton {
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    min-width: 105px;
}

QPushButton#topSecondaryButton:hover,
QPushButton#topConnectionButton:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #0f4c81;
}

/* ---------- Sidebar ---------- */
QFrame#sideBar {
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 10px;
}

QLabel#sideCaption {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px 8px 8px;
}

QPushButton#navButton {
    background: transparent;
    color: #475569;
    border: 0;
    border-radius: 7px;
    padding: 11px 12px;
    text-align: right;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#navButton:hover {
    background: #f1f6fb;
    color: #0f4c81;
}

QPushButton#navButton:checked {
    background: #e7f2ff;
    color: #1268ba;
    border-right: 3px solid #1677d2;
    font-weight: 700;
}

QFrame#sideSeparator,
QFrame#panelSeparator {
    color: #e2e8f0;
    background: #e2e8f0;
    max-height: 1px;
}

QLabel#mutedText {
    color: #94a3b8;
    font-size: 11px;
    padding: 0 8px;
}

QLabel#phoneStatusUnknown {
    color: #64748b;
    font-weight: 700;
    padding: 5px 8px;
}

QLabel#phoneStatusConnected {
    color: #15803d;
    font-weight: 700;
    padding: 5px 8px;
}

QLabel#phoneStatusDisconnected {
    color: #dc2626;
    font-weight: 700;
    padding: 5px 8px;
}

QLabel#phoneStatusChecking {
    color: #d97706;
    font-weight: 700;
    padding: 5px 8px;
}

/* ---------- Main content ---------- */
QFrame#contentCard {
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 10px;
}

QWidget#pageHeader {
    background: #ffffff;
    border-bottom: 1px solid #e7edf4;
}

QLabel#pageTitle {
    color: #145fa5;
    font-size: 23px;
    font-weight: 800;
}

QLabel#pageSubtitle {
    color: #64748b;
    font-size: 12px;
}

QStackedWidget#mainStack {
    background: #ffffff;
}

/* ---------- Phone panel ---------- */
QFrame#phonePanel {
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 10px;
}

QLabel#panelTitle {
    color: #334155;
    font-size: 14px;
    font-weight: 800;
}

QLabel#phoneIndicatorUnknown,
QLabel#phoneIndicatorConnected,
QLabel#phoneIndicatorDisconnected,
QLabel#phoneIndicatorChecking {
    font-size: 42px;
    font-weight: 700;
    padding: 4px 0;
}

QLabel#phoneIndicatorUnknown {
    color: #94a3b8;
}

QLabel#phoneIndicatorConnected {
    color: #22c55e;
}

QLabel#phoneIndicatorDisconnected {
    color: #ef4444;
}

QLabel#phoneIndicatorChecking {
    color: #f59e0b;
}

QLabel#phoneState {
    color: #334155;
    font-size: 13px;
    font-weight: 700;
}

QLabel#phoneAddress {
    color: #64748b;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 8px;
}

QPushButton#panelActionButton {
    background: #ffffff;
    color: #1268ba;
    border: 1px solid #b9d5ef;
}

QPushButton#panelActionButton:hover {
    background: #eef7ff;
    border-color: #7cb4e7;
}

QPushButton#quickLink {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #e2e8f0;
    text-align: right;
    font-weight: 600;
}

QPushButton#quickLink:hover {
    background: #eef7ff;
    color: #1268ba;
    border-color: #c3ddf4;
}

QLabel#panelHint {
    color: #64748b;
    background: #f8fafc;
    border-radius: 6px;
    padding: 9px;
    font-size: 11px;
}

/* ---------- General controls ---------- */
QGroupBox {
    background: #ffffff;
    border: 1px solid #d9e2ec;
    border-radius: 8px;
    margin-top: 14px;
    padding: 18px 14px 14px 14px;
    font-weight: 700;
    color: #111827;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 8px;
    color: #334155;
    background: #ffffff;
}

QPushButton {
    background: #1677d2;
    color: #ffffff;
    border: 1px solid #1677d2;
    padding: 8px 15px;
    border-radius: 6px;
    min-height: 28px;
    font-weight: 600;
}

QPushButton:hover {
    background: #1268ba;
    border-color: #1268ba;
}

QPushButton:pressed {
    background: #0f579c;
    border-color: #0f579c;
}

QPushButton:disabled {
    background: #e5e7eb;
    border-color: #d1d5db;
    color: #94a3b8;
}

QPushButton#btnDanger {
    background: #ffffff;
    color: #dc2626;
    border-color: #fecaca;
}

QPushButton#btnDanger:hover {
    background: #fef2f2;
    border-color: #fca5a5;
}

QPushButton#btnSuccess {
    background: #16a34a;
    border-color: #16a34a;
}

QPushButton#btnSuccess:hover {
    background: #15803d;
    border-color: #15803d;
}

QPushButton#btnWarning {
    background: #d97706;
    border-color: #d97706;
}

QPushButton#btnWarning:hover {
    background: #b45309;
    border-color: #b45309;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QComboBox {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 26px;
    selection-background-color: #1677d2;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #1677d2;
}

QComboBox::drop-down {
    border: 0;
    width: 26px;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #d9e2ec;
    border-radius: 8px;
    gridline-color: #edf1f5;
    selection-background-color: #e1f1ff;
    selection-color: #0f172a;
    outline: 0;
}

QTableWidget::item {
    padding: 8px 10px;
    border: 0;
}

QTableWidget::item:selected {
    background: #e1f1ff;
    color: #0f172a;
}

QHeaderView::section {
    background: #f1f5f9;
    color: #334155;
    padding: 9px 10px;
    border: 0;
    border-bottom: 1px solid #d9e2ec;
    font-weight: 700;
}

QProgressBar {
    background: #e5e7eb;
    border: 0;
    border-radius: 6px;
    text-align: center;
    min-height: 18px;
    color: #0f172a;
    font-weight: 600;
}

QProgressBar::chunk {
    background: #1677d2;
    border-radius: 6px;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d9e2ec;
    color: #475569;
    padding: 3px 8px;
}

QMessageBox,
QDialog {
    background: #f5f7fb;
}

/* ---------- Integrated send workspace ---------- */
QPushButton#workspaceModeButton {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #dbe4ef;
    min-width: 135px;
}

QPushButton#workspaceModeButton:hover {
    background: #eef7ff;
    color: #1268ba;
    border-color: #b9d5ef;
}

QPushButton#workspaceModeButton:checked {
    background: #e7f2ff;
    color: #1268ba;
    border-color: #8fc0eb;
    font-weight: 800;
}

QStackedWidget#sendWorkspace,
QWidget#composerPage,
QWidget#historyPage {
    background: transparent;
}

QFrame#composerCard {
    background: #fbfdff;
    border: 1px solid #dbe4ef;
    border-radius: 9px;
}

QLabel#sectionTitle {
    color: #145fa5;
    font-size: 18px;
    font-weight: 800;
}

QLabel#fieldLabel {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    min-width: 92px;
}

QTextEdit#messageEditor {
    background: #ffffff;
    border: 1px solid #b9c9d9;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
}

QTextEdit#messageEditor:focus {
    border: 1px solid #1677d2;
}

QLabel#messageMeta {
    color: #64748b;
    font-size: 11px;
}

QLabel#messageMetaStrong {
    color: #145fa5;
    font-size: 12px;
    font-weight: 800;
}

QPushButton#secondaryAction {
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
}

QPushButton#secondaryAction:hover {
    background: #f8fafc;
    color: #1268ba;
    border-color: #94a3b8;
}

QFrame#composerActionBar {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
